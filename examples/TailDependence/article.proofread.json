 [{"wellDefined": "True",
   "symbol": "\\mathcal{C}",
   "sentence": 6,
   "name": "copulas",
   "module": "TailDependence.Proofs",
   "lean": "fun x => Proofread.UnitSquare.distFn2 x ∧ Proofread.UnitSquare.dfUniformMarginals x",
   "key": "\\mathcal{C}",
   "justification": "TailDependence.Proofs.defined0",
   "index": 0},
  {"wellDefined": "True",
   "symbol": "\\operatorname{PQD}",
   "sentence": 8,
   "name": "positivelyQuadrantDependent",
   "module": "TailDependence.Proofs",
   "lean": "fun x => ∀ (x_1 x_2 : I), ↑x_1 * ↑x_2 ≤ x x_1 x_2",
   "key": "",
   "justification": "TailDependence.Proofs.defined1",
   "index": 1},
  {"wellDefined":
   "∀ (x : I → I → ℝ),\n  copulas x →\n    ∀ (x : I) (x : ℝ),\n      0 < x ∧ x ≤ 1 →\n        ∀ (x_2 : ℝ), 0 < x_2 ∧ x_2 ≤ 1 → x ≤ x_2 → ((0 ≤ x_2 ∧ x_2 ≤ 1) ∧ ¬x_2 = 0) ∧ (0 ≤ x ∧ x ≤ 1) ∧ ¬x = 0",
   "symbol": "\\operatorname{LTD}",
   "sentence": 9,
   "name": "leftTailDecreasing",
   "module": "TailDependence.Proofs",
   "lean":
   "fun x =>\n  ∀ (x_1 : I) (x_2 : ℝ),\n    0 < x_2 ∧ x_2 ≤ 1 →\n      ∀ (x_4 : ℝ),\n        0 < x_4 ∧ x_4 ≤ 1 → x_2 ≤ x_4 → x (Set.projIcc 0 1 ⋯ x_4) x_1 / x_4 ≤ x (Set.projIcc 0 1 ⋯ x_2) x_1 / x_2",
   "key": "",
   "justification": "TailDependence.Proofs.defined2",
   "index": 2},
  {"wellDefined":
   "∀ (x : I → I → ℝ),\n  copulas x →\n    ∀ (x : I) (x : ℝ),\n      0 ≤ x ∧ x < 1 →\n        ∀ (x_2 : ℝ), 0 ≤ x_2 ∧ x_2 < 1 → x ≤ x_2 → ((0 ≤ x ∧ x ≤ 1) ∧ ¬1 - x = 0) ∧ (0 ≤ x_2 ∧ x_2 ≤ 1) ∧ ¬1 - x_2 = 0",
   "symbol": "\\operatorname{RTI}",
   "sentence": 10,
   "name": "rightTailIncreasing",
   "module": "TailDependence.Proofs",
   "lean":
   "fun x =>\n  ∀ (x_1 : I) (x_2 : ℝ),\n    0 ≤ x_2 ∧ x_2 < 1 →\n      ∀ (x_4 : ℝ),\n        0 ≤ x_4 ∧ x_4 < 1 →\n          x_2 ≤ x_4 →\n            (1 - x_2 - ↑x_1 + x (Set.projIcc 0 1 ⋯ x_2) x_1) / (1 - x_2) ≤\n              (1 - x_4 - ↑x_1 + x (Set.projIcc 0 1 ⋯ x_4) x_1) / (1 - x_4)",
   "key": "",
   "justification": "TailDependence.Proofs.defined3",
   "index": 3}],
